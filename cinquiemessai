function setRepairModels(){
  const s=document.getElementById('rmodel');
  const models=[...new Set(REPAIRS.map(x=>x.model))];
  s.innerHTML=models.map(m=>`<option>${m}</option>`).join('');
  renderRepairPrices();
}
function renderRepairPrices(){
  const model=document.getElementById('rmodel').value;
  const list=REPAIRS.filter(x=>x.model===model);
  document.getElementById('rservice').innerHTML=list.map((x,i)=>`<option value="${i}">${x.service} — ${x.price} €</option>`).join('');
  document.getElementById('repairPrices').innerHTML=list.map((x,i)=>`<div class="repairPrice ${i===0?'selected':''}" onclick="chooseRepair(${i})"><b>${x.service}</b><span>${x.price} €</span></div>`).join('');
  selectRepair();
}
function chooseRepair(i){document.getElementById('rservice').value=String(i);document.querySelectorAll('.repairPrice').forEach((x,n)=>x.classList.toggle('selected',n===i));selectRepair();}
function selectRepair(){
  const model=document.getElementById('rmodel').value;
  const idx=Number(document.getElementById('rservice').value||0);
  const item=REPAIRS.filter(x=>x.model===model)[idx];
  if(item) document.getElementById('rselected').value=item.service+' — '+item.price+' € TTC';
}
function repairMessage(){
  const name=document.getElementById('rname').value.trim();
  const phone=document.getElementById('rphone').value.trim();
  const email=document.getElementById('remail').value.trim();
  const device=document.getElementById('rdevice').value.trim();
  const city=document.getElementById('rcity').value.trim();
  const problem=document.getElementById('rproblem').value.trim();
  const extra=document.getElementById('rextra').value.trim();
  const contact=document.getElementById('rcontact').value;
  const selected=document.getElementById('rselected').value;
  if(!name||!phone||!device||!problem){alert('Merci de compléter les champs obligatoires.');return null;}
  return `DEMANDE DE RÉPARATION PHOENIX LAB

Nom : ${name}
Téléphone : ${phone}
E-mail : ${email||'Non renseigné'}
Appareil : ${device}
Réparation : ${selected||'Non précisée'}
Ville : ${city||'Non renseignée'}
Préférence : ${contact}

PROBLÈME :
${problem}

INFORMATIONS SUPPLÉMENTAIRES :
${extra||'Aucune'}`;
}
function sendEmail(){
  const m=repairMessage(); if(!m)return;
  location.href='mailto:lephoenixlab@gmail.be?subject='+encodeURIComponent('Demande de réparation - Phoenix Lab')+'&body='+encodeURIComponent(m);
}
function sendWhatsApp(){
  const m=repairMessage(); if(!m)return;
  window.open('https://wa.me/32493329391?text='+encodeURIComponent(m),'_blank');
}

