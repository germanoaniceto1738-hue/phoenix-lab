let cart = [];
let activeType = 'all';
let activeSearch = '';

const euro = n => Number(n).toLocaleString('fr-BE',{minimumFractionDigits:2,maximumFractionDigits:2});
function go(sel){document.querySelector(sel)?.scrollIntoView({behavior:'smooth'});}

function visual(type){
  if(type==='phone') return '<div class="visualPhone"></div>';
  if(type==='used') return '<div class="visualUsed"></div>';
  if(type==='case') return '<div class="visualCase"></div>';
  if(type==='glass') return '<div class="visualGlass"></div>';
  if(type==='buds') return '<div class="visualBuds"></div>';
  if(type==='charger') return '<div class="visualCharger"></div>';
  if(type==='cable') return '<div class="visualCable"></div>';
  if(type==='power') return '<div class="visualPower"></div>';
  if(type==='gaming') return '<div class="visualGaming"></div>';
  return '<div style="font-size:48px">▣</div>';
}

function safeJson(obj){return JSON.stringify(obj).replace(/"/g,'&quot;');}

function card(p){
  const can = Number(p.price)>0;
  return `<article class="product" onclick="openProduct(${safeJson(p)})">
    <span class="tag">${p.tag}</span>
    <div class="photo">${visual(p.visual)}</div>
    <h3>${p.name}</h3>
    <div class="sub">${p.subtitle || p.brand || ''}</div>
    <div class="price">${can ? euro(p.price)+' €' : 'Prix à définir'}</div>
    <div class="stars">★★★★★</div>
    <div class="actionsRow">
      <button class="add" ${can?'':'disabled'} onclick="event.stopPropagation();${can ? `addProduct(${safeJson(p)})` : ''}">${can?'Ajouter au panier':'Prix à définir'}</button>
      <button class="heart" onclick="event.stopPropagation();this.classList.toggle('active')">♡</button>
    </div>
  </article>`;
}

function renderBest(){document.getElementById('bestGrid').innerHTML=BEST.map(card).join('');}

function filterProducts(){
  const q=activeSearch.trim().toLowerCase();
  let list=PRODUCTS.filter(p=>{
    const text=(p.name+' '+(p.subtitle||'')+' '+(p.brand||'')).toLowerCase();
    return (activeType==='all'||p.type===activeType) && (!q||text.includes(q));
  });
  const brand=document.getElementById('brandFilter')?.value||'all';
  if(brand!=='all') list=list.filter(p=>p.brand===brand);
  document.getElementById('grid').innerHTML=list.length
    ? list.map(card).join('')
    : '<div class="box" style="grid-column:1/-1"><b>Aucun produit trouvé.</b><p class="muted">Essayez un autre modèle, une autre marque ou une autre catégorie.</p></div>';
  document.getElementById('catalogCount').textContent=list.length+' produit'+(list.length>1?'s':'');
}

function setType(t){
  activeType=t;
  document.getElementById('typeFilter').value=t;
  filterProducts();
  go('#catalogue');
}

function syncFilters(){
  activeSearch=document.getElementById('catalogSearch').value;
  activeType=document.getElementById('typeFilter').value;
  filterProducts();
}

function openProduct(p){
  const can=Number(p.price)>0;
  document.getElementById('modal').innerHTML=`
    <button class="close" onclick="closeModal()">×</button>
    <div class="modalGrid">
      <div class="modalVisual">${visual(p.visual)}</div>
      <div>
        <div class="eyebrow">${p.tag}</div>
        <h2>${p.name}</h2>
        <p class="muted">${p.subtitle||p.brand||''}</p>
        <div class="price" style="font-size:28px">${can?euro(p.price)+' €':'Prix à définir'}</div>
        <p class="muted">Fiche produit interactive du prototype. Cette zone pourra ensuite accueillir les vraies photos, le stock, les variantes et les informations détaillées.</p>
        <button class="btn red" ${can?'':'disabled'} onclick="${can?`addProduct(${safeJson(p)});closeModal()`:''}">${can?'Ajouter au panier':'Prix à définir'}</button>
      </div>
    </div>`;
  document.getElementById('modalBack').classList.add('show');
}
function closeModal(){document.getElementById('modalBack').classList.remove('show');}

function addProduct(p){
  const existing=cart.find(x=>x.name===p.name);
  if(existing) existing.qty++;
  else cart.push({...p,qty:1});
  updateCart();
  openCart();
}
function updateCart(){
  document.getElementById('count').textContent=cart.reduce((s,p)=>s+p.qty,0);
  const box=document.getElementById('cart');
  if(!cart.length) box.innerHTML='<p class="muted">Votre panier est vide.</p>';
  else box.innerHTML=cart.map((p,i)=>`
    <div class="cartrow">
      <div style="width:58px;height:58px;background:#171719;border-radius:7px;display:grid;place-items:center">${visual(p.visual)}</div>
      <div><b>${p.name}</b><div class="sub">${euro(p.price)} €</div>
        <div class="qty"><button onclick="changeQty(${i},-1)">−</button><span>${p.qty}</span><button onclick="changeQty(${i},1)">+</button></div>
      </div>
      <button class="heart" onclick="removeItem(${i})">×</button>
    </div>`).join('');
  document.getElementById('total').textContent=euro(cart.reduce((s,p)=>s+p.price*p.qty,0))+' €';
}
function changeQty(i,d){cart[i].qty+=d;if(cart[i].qty<=0)cart.splice(i,1);updateCart();}
function removeItem(i){cart.splice(i,1);updateCart();}
